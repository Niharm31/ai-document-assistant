# Production / cloud:
# Point this to a publicly reachable OpenAI-compatible LLM endpoint.
LLM_BASE_URL=https://YOUR-LLM-ENDPOINT/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# If running Docker locally on Windows with llama.cpp on the host:
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_API_KEY=local
# LLM_MODEL=D:\Great_sage\models\Qwen3-4B-Q4_K_M.gguf

APP_ENV=production
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
MAX_UPLOAD_MB=20

# For a public site, replace * with your exact frontend origin(s), comma-separated.
CORS_ORIGINS=*
